{
  "env": {
    "GITHUB_MCP_PAT": {{ keyring "github" "mcp" | default "" | quote }}
  },
  "permissions": {
    "allow": [
      "Bash(jj log:*)",
      "Bash(jj status*)",
      "Bash(jj show*)",
      "Bash(jj diff:*)",
      "Bash(jj describe*)",
      "Bash(jj commit*)",
      "Bash(jj bookmark create*)",
      "Bash(jj git fetch*)",
      "Bash(jj rebase*)",
      "Bash(jj squash*)",
      "Bash(jj new*)"
    ],
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "disableAutoMode": "disable"
  },
  "model": "opus[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "jj util snapshot --quiet",
            "timeout": 10,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\" sound name \"Ping\"'"
          }
        ]
      }
    ]
  }
}

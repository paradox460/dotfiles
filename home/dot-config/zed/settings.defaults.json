{
  "show_edit_predictions": true,
  "language_models": {},
  "agent_servers": {
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "zed"
  },
  "context_servers": {
    "mcp-server-github": {
      "enabled": false
    }
  },
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "default_profile": "write",
    "dock": "right",
    "play_sound_when_agent_done": "always",
    "tool_permissions": {
      "default": "allow"
    },
    "use_modifier_to_send": true,
    "notify_when_agent_waiting": "all_screens",
    "enable_feedback": false
  }
}

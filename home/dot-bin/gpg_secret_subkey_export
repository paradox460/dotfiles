#!/usr/bin/env fish
# gpg-export-subkey.fish
#
# Creates a GPG Ed25519 signing subkey and exports it (without the primary
# secret key) for use on another machine (e.g. for signing GitHub commits).
#
# Usage:
#   gpg-export-subkey.fish [options] [KEY_FINGERPRINT_OR_ID]
#
# Options:
#   -e, --expiry DURATION   Subkey expiry: e.g. 1y, 6m, 0 (none). Default: 2y
#   -o, --output DIR        Output directory. Default: ./gpg-subkey-export-XXXXXXXX
#   -y, --yes               Skip confirmation prompts
#   -h, --help              Show this help message

# ── Helpers ───────────────────────────────────────────────────────────────────

function info;    set_color cyan;   echo "  ▶ $argv"; set_color normal; end
function success; set_color green;  echo "  ✔ $argv"; set_color normal; end
function warn;    set_color yellow; echo "  ⚠ $argv"; set_color normal; end
function err;     set_color red;    echo "  ✘ $argv" >&2; set_color normal; end

function section
    set_color --bold magenta; echo ""; echo "── $argv"; set_color normal
end

function banner
    set_color --bold white
    echo ""
    echo "═══════════════════════════════════════════════════"
    echo "  GPG Signing Subkey Exporter"
    echo "═══════════════════════════════════════════════════"
    set_color normal; echo ""
end

function show_help
    echo "Usage: gpg-export-subkey.fish [options] [KEY_FINGERPRINT_OR_ID]"
    echo ""
    echo "Options:"
    echo "  -e, --expiry DURATION   Subkey expiry duration (default: 2y)"
    echo "                          Examples: 1y, 6m, 90d, 0 (never expires)"
    echo "  -o, --output DIR        Output directory (default: ./gpg-subkey-export-XXXXXXXX)"
    echo "  -y, --yes               Skip all confirmation prompts"
    echo "  -h, --help              Show this help message"
    echo ""
    echo "Examples:"
    echo "  gpg-export-subkey.fish                           # interactive key selection"
    echo "  gpg-export-subkey.fish AABBCCDDEEFF1122          # specify key directly"
    echo "  gpg-export-subkey.fish -e 1y AABBCCDDEEFF1122   # 1-year expiry"
    echo "  gpg-export-subkey.fish -e 0 -y AABBCCDDEEFF1122 # no expiry, no prompts"
end

# ── Expiry validator (called by argparse via !) ───────────────────────────────

function _validate_expiry
    if not string match -rq '^(0|[1-9][0-9]*[dwmy])$' "$_flag_value"
        echo "Invalid expiry '$_flag_value'. Use 0 (no expiry) or a duration like 1y, 6m, 90d, 4w."
        return 1
    end
end

# ── Argument parsing ──────────────────────────────────────────────────────────

argparse \
    --name gpg-export-subkey \
    --max-args 1 \
    'h/help' \
    'y/yes' \
    'e/expiry=!_validate_expiry' \
    'o/output=' \
    -- $argv
or exit 1

if set -q _flag_help
    show_help
    exit 0
end

# Apply defaults for optional flags
set expiry 2y
if set -q _flag_expiry
    set expiry $_flag_expiry
end

set custom_out ""
if set -q _flag_output
    set custom_out $_flag_output
end

set skip_confirm false
if set -q _flag_yes
    set skip_confirm true
end

set key_id ""
if set -q argv[1]
    set key_id $argv[1]
end

# ── Preflight ─────────────────────────────────────────────────────────────────

banner

section "Preflight checks"

if not command -q gpg
    err "gpg is not installed or not in PATH. Please install GnuPG."
    exit 1
end

info "Using: "(gpg --version | head -1)

# ── Key selection ─────────────────────────────────────────────────────────────

section "Primary key selection"

set secret_keys (gpg --list-secret-keys --with-colons 2>/dev/null \
    | grep "^fpr" | awk -F: '{print $10}')

if test (count $secret_keys) -eq 0
    err "No secret keys found in your GPG keyring."
    exit 1
end

if test -z "$key_id"
    if test (count $secret_keys) -eq 1
        set key_id $secret_keys[1]
        info "One secret key found — selecting it automatically."
    else
        echo ""
        info "Available secret keys:"
        echo ""
        gpg --list-secret-keys --keyid-format=long 2>/dev/null
        echo ""
        read --prompt-str "  Enter the fingerprint or long key ID to use: " key_id
        set key_id (string trim $key_id)
    end
end

if test -z "$key_id"
    err "No key selected. Aborting."
    exit 1
end

# Resolve to full fingerprint
set primary_fpr (gpg --list-keys --with-colons "$key_id" 2>/dev/null \
    | grep "^fpr" | head -1 | awk -F: '{print $10}')

if test -z "$primary_fpr"
    err "Could not resolve key '$key_id'. Is it in your keyring?"
    exit 1
end

set uid (gpg --list-keys --with-colons "$primary_fpr" 2>/dev/null \
    | grep "^uid" | head -1 | awk -F: '{print $10}')

success "Selected: $uid"
info    "Fingerprint:   $primary_fpr"
info    "Subkey expiry: $expiry (0 = never)"

# ── Confirm ───────────────────────────────────────────────────────────────────

if test "$skip_confirm" = false
    echo ""
    read --prompt-str "  Create a new Ed25519 signing subkey for this key? [Y/n] " confirm
    set confirm (string lower (string trim $confirm))
    if test "$confirm" = n; or test "$confirm" = no
        warn "Aborted by user."
        exit 0
    end
end

# ── Create signing subkey ─────────────────────────────────────────────────────

section "Creating Ed25519 signing subkey"

info "gpg --quick-add-key $primary_fpr ed25519 sign $expiry"
echo ""

gpg --quick-add-key "$primary_fpr" ed25519 sign "$expiry"
or begin
    err "Failed to create subkey. Check your passphrase and try again."
    exit 1
end

success "Signing subkey created."

# ── Identify the new subkey ───────────────────────────────────────────────────

section "Identifying new subkey"

set subkey_fprs (gpg --list-keys --with-colons "$primary_fpr" 2>/dev/null \
    | grep -A1 "^sub" \
    | grep "^fpr" \
    | awk -F: '{print $10}')

if test (count $subkey_fprs) -eq 0
    err "Could not find any subkeys after creation."
    exit 1
end

# Newly created subkey is always last
set subkey_fpr $subkey_fprs[-1]
set subkey_id (string sub -s -16 $subkey_fpr)

success "Subkey fingerprint: $subkey_fpr"
info    "Subkey long ID:     $subkey_id"

# ── Output directory ──────────────────────────────────────────────────────────

section "Preparing output"

if test -n "$custom_out"
    set out_dir "$custom_out"
else
    set out_dir "./gpg-subkey-export-"(string sub -s 1 -l 8 $subkey_fpr)
end

mkdir -p "$out_dir"
or begin
    err "Could not create output directory '$out_dir'."
    exit 1
end

set secret_file "$out_dir/signing-subkey-secret.asc"
set public_file "$out_dir/public-key.asc"
set readme_file "$out_dir/README.txt"

info "Output directory: $out_dir"

# ── Export subkey secret ──────────────────────────────────────────────────────

section "Exporting signing subkey secret (primary secret NOT included)"

# The ! suffix exports ONLY this specific subkey
gpg --armor --export-secret-subkeys "$subkey_fpr!" > "$secret_file"
or begin; err "Export of secret subkey failed."; exit 1; end

if not test -s "$secret_file"
    err "Secret subkey file is empty. Something went wrong."
    exit 1
end

success "Secret subkey → $secret_file"

# ── Export public key ─────────────────────────────────────────────────────────

section "Exporting full public key (for GitHub)"

gpg --armor --export "$primary_fpr" > "$public_file"
or begin; err "Export of public key failed."; exit 1; end

if not test -s "$public_file"
    err "Public key file is empty. Something went wrong."
    exit 1
end

success "Public key → $public_file"

# ── Write README ──────────────────────────────────────────────────────────────

section "Writing setup instructions for Machine B"

echo "GPG Signing Subkey — Setup Instructions for Machine B
======================================================

Files in this package:
  signing-subkey-secret.asc  — Secret signing subkey (primary secret NOT included)
  public-key.asc             — Full public key (needed for GitHub)

Primary key fingerprint : $primary_fpr
Signing subkey FPR      : $subkey_fpr
Signing subkey long ID  : $subkey_id
UID                     : $uid
Subkey expires          : $expiry

══════════════════════════════════════════════════
STEP 1 — Transfer these files securely to Machine B
  (use scp, USB, or a password manager — NOT email or chat)

STEP 2 — Import the subkey secret
  gpg --import signing-subkey-secret.asc

STEP 3 — Set trust level
  gpg --edit-key $primary_fpr
  gpg> trust  →  choose 5 (ultimate)
  gpg> quit

STEP 4 — Verify import (you should see 'ssb' but NOT 'sec')
  gpg --list-secret-keys --keyid-format=long

STEP 5 — Configure git
  git config --global user.signingkey $subkey_id!
  git config --global commit.gpgsign true

STEP 6 — Upload public-key.asc to GitHub
  GitHub → Settings → SSH and GPG keys → New GPG key

STEP 7 — Test
  git commit -m 'test signed commit'
  git log --show-signature -1

══════════════════════════════════════════════════
SECURITY NOTES
  - Delete signing-subkey-secret.asc from Machine B after setup.
  - If Machine B is compromised, revoke only this subkey from Machine A:
      gpg --edit-key $primary_fpr
      gpg> key $subkey_id
      gpg> revkey
      gpg> save
    Then re-upload public-key.asc to GitHub.
══════════════════════════════════════════════════
" > "$readme_file"

success "README → $readme_file"

# ── Summary ───────────────────────────────────────────────────────────────────

set_color --bold white
echo ""
echo "═══════════════════════════════════════════════════"
echo "  All done!"
echo "═══════════════════════════════════════════════════"
set_color normal
echo ""
echo "  Output folder : $out_dir"
echo "  Files:"
echo "    · $secret_file"
echo "    · $public_file"
echo "    · $readme_file"
echo ""
warn "Securely transfer '$out_dir/' to Machine B, then follow README.txt."
echo ""

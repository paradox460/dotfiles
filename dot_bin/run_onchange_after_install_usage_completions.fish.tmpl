#!/usr/bin/env fish
# Regenerates fish completions for usage-shebang scripts in ~/.bin.
# chezmoi reruns this when any line below changes.
{{- if lookPath "usage" }}
# {{ output "usage" "--version" | trim }}
{{- end }}
{{- range glob (joinPath .chezmoi.sourceDir "dot_bin/*") }}
{{-   if not (stat .).isDir }}
{{-     $content := include . }}
{{-     if hasPrefix "#!/usr/bin/env -S usage " $content }}
# {{ base . }} {{ $content | sha256sum }}
{{-     end }}
{{-   end }}
{{- end }}

if not command -q usage
  echo "usage not found; skipping usage completion generation" >&2
  exit 0
end

set -l bin_dir $HOME/.bin
set -l dest_dir $HOME/.local/share/fish/vendor_completions.d
set -l header_prefix "# @generated by usage-cli from "
mkdir -p $dest_dir; or exit 1

set -l generated
for file in $bin_dir/*
  test -f $file; and test -x $file; or continue
  read -l shebang < $file
  string match -q -- '#!/usr/bin/env -S usage *' $shebang; or continue
  set -l name (path basename -- $file)
  set -l dest $dest_dir/$name.fish
  if test -e $dest
    read -l existing < $dest
    if test "$existing" != "$header_prefix$file"
      echo "Skipping $name: $dest was not generated from $file" >&2
      continue
    end
  end
  set -l completion (usage generate completion fish $name -f $file | string collect)
  if test $pipestatus[1] -ne 0
    echo "Failed to generate fish completion for $file" >&2
    exit 1
  end
  printf '%s\n' $completion > $dest; or exit 1
  set -a generated $file
end

# Remove completions whose ~/.bin script is gone or no longer uses usage
for dest in $dest_dir/*.fish
  read -l header < $dest
  string match -q -- "$header_prefix$bin_dir/*" $header; or continue
  set -l origin (string replace -- $header_prefix '' $header)
  contains -- $origin $generated; or rm -f -- $dest
end
